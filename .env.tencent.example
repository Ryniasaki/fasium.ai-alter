DEPLOY_DATA_ROOT=/data/fasium/runtime
INTERNAL_TENANT_API_URL=http://tenant-service:8081
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_SHOW_CREDITS_NAV=true
NEXT_PUBLIC_BILLING_NAV_TARGET=points
TENANT_SERVICE_CPUS=1.50

RUNNINGHUB_API_KEY=replace-me
RUNNINGHUB_HOST=https://www.runninghub.cn
REQUEST_TIMEOUT_SECONDS=60
POLL_INTERVAL_SECONDS=8
MAX_POLL_SECONDS=300

SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
JWT_SIGNING_ALGORITHM=HS256
JWT_ALLOW_HS256_FALLBACK=true
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_TYPE=postgresql
POSTGRES_HOST=172.17.0.7
POSTGRES_PORT=5432
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DATABASE=postgres

REDIS_URL=redis://redis:6379/0
TASK_QUEUE_ENABLED=true
TASK_QUEUE_NAME=tenant-task-completion

OUTPUT_STORAGE_BACKEND=cos
