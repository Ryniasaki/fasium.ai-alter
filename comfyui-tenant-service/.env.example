# ===========================================
# ComfyUI Tenant Service 閰嶇疆
# ===========================================

# JWT 璁よ瘉閰嶇疆
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
JWT_SIGNING_ALGORITHM=RS256
JWT_VERIFY_ALGORITHMS=RS256,HS256
JWT_KEY_ID=v1
JWT_PRIVATE_KEY_PATH=./keys/jwt_rs256_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_rs256_public.pem
# Optional multi-key map for rotation: {"v1":"-----BEGIN PUBLIC KEY-----...","v2":"-----BEGIN PUBLIC KEY-----..."}
# JWT_PUBLIC_KEYS_JSON=
# Fallback switch for rollback during migration. Set false after full RS256 cutover.
JWT_ALLOW_HS256_FALLBACK=true
# Optional dedicated legacy HS256 secret; if empty, SECRET_KEY is used.
# JWT_HS256_LEGACY_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 鍚庣鏈嶅姟閰嶇疆
RUNNINGHUB_SERVICE_URL=http://localhost:8080
RUNNINGHUB_TASK_TIMEOUT_SECONDS=2400

# ===========================================
# 瀛樺偍閰嶇疆 - 閫夋嫨瀛樺偍鏂瑰紡
# ===========================================
# 鏀寔鐨勫瓨鍌ㄧ被鍨? mysql, sqlite, json
# 榛樿浣跨敤 json (鏈€绠€鍗曪紝鏃犻渶鏁版嵁搴?
STORAGE_TYPE=json

# ===========================================
# MySQL 閰嶇疆 (褰?STORAGE_TYPE=mysql 鏃朵娇鐢?
# ===========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=comfyui_tenant_service

# ===========================================
# SQLite 閰嶇疆 (褰?STORAGE_TYPE=sqlite 鏃朵娇鐢?
# ===========================================
SQLITE_PATH=./tenant_service.db

# ===========================================
# JSON 瀛樺偍閰嶇疆 (褰?STORAGE_TYPE=json 鏃朵娇鐢?
# ===========================================
JSON_STORAGE_PATH=./database

# ===========================================
# 鍏朵粬閰嶇疆
# ===========================================
OUTPUT_STORAGE_BACKEND=local
OUTPUT_STORAGE_PATH=./output
OUTPUT_COS_SECRET_ID=
OUTPUT_COS_SECRET_KEY=
OUTPUT_COS_BUCKET=
OUTPUT_COS_REGION=ap-shanghai
# COS 存储目录前缀（仅在 OUTPUT_STORAGE_BACKEND=cos 时生效）
# 默认值：root/fasium/output
OUTPUT_COS_PREFIX=root/fasium/output
OUTPUT_COS_PUBLIC_BASE_URL=

# 閫熺巼闄愬埗
RATE_LIMIT_PER_MINUTE=60

# 鏃ュ織绾у埆
LOG_LEVEL=INFO
# ===========================================
# LLM service configuration
# ===========================================
LLM_SERVICE_URL=http://localhost:3000/v1
LLM_API_KEY=your_llm_api_key
LLM_DEFAULT_MODEL=gpt-4.1

# ===========================================
# PoloAPI configuration
# ===========================================
# 閫氱敤 PoloAPI Key锛堥櫎 gemini-2.5-flash-image 澶栫殑妯″瀷榛樿浣跨敤锛?
POLOAPI_APIKEY=your_poloapi_api_key
POLOAPI_TEXT_BASE_URL=https://open.cherryin.net/v1
POLOAPI_TEXT_APIKEY=
POLOAPI_TEXT_MODEL=gemini-3-flash-preview
POLOAPI_AUDIT_BASE_URL=https://api.deepseek.com
POLOAPI_AUDIT_APIKEY=your_deepseek_api_key
POLOAPI_AUDIT_MODEL=deepseek-v4-pro
# 涓撶敤浜?gemini-2.5-flash-image / gemini-3-pro-image-preview 鐨?PoloAPI Key
POLOAPI_BASE_URL=https://open.cherryin.net/v1
POLOAPI_DEFAULT_MODEL=gemini-2.5-flash-image
POLOAPI_BAOKUAN_MODEL=gemini-2.5-flash-image-preview

# ===========================================
# OpenAI-compatible image provider switch
# ===========================================
# Supported values: poloapi, vod
IMAGE_PROVIDER=poloapi

# Tencent Cloud VOD image provider configuration
VOD_SECRET_ID=
VOD_SECRET_KEY=
VOD_REGION=ap-guangzhou
VOD_ENDPOINT=vod.tencentcloudapi.com
VOD_HTTP_TIMEOUT_MS=60000
VOD_SUB_APP_ID=
VOD_MODEL_NAME=GEM
VOD_MODEL_VERSION=3.1
VOD_TASK_POLL_INTERVAL_SECONDS=2
VOD_TASK_TIMEOUT_SECONDS=180
VOD_VIDEO_MODEL_NAME=Kling
VOD_VIDEO_MODEL_VERSION=3.0-Omni
VOD_VIDEO_DURATION_SECONDS=5
VOD_VIDEO_RESOLUTION=720P
VOD_VIDEO_ENHANCE_PROMPT=Enabled
VOD_VIDEO_AUDIO_GENERATION=Disabled
VOD_VIDEO_INPUT_REGION=Mainland

# Seedance 2.0 video generation configuration
SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL_ID=doubao-seedance-2-0-260128
