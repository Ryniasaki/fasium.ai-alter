# ComfyUI Tenant Service API URL
# 默认指向本地开发服务器
NEXT_PUBLIC_TENANT_API_URL=http://localhost:8081

# 开发调试模式
# 设置为 true 时，跳过登录注册验证，直接进入系统
# 设置为 false 时，需要正常的登录注册流程
NEXT_PUBLIC_DEV_MODE=true

# 左侧导航是否展示点数入口；管理员账号始终展示
NEXT_PUBLIC_SHOW_CREDITS_NAV=true

# 左侧导航充值入口：points 显示“分数”(/points)，credits 显示“点数”(/credits)
NEXT_PUBLIC_BILLING_NAV_TARGET=points
